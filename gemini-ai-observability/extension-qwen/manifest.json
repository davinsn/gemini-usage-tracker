{
  "manifest_version": 3,
  "name": "Qwen AI Usage Collector",
  "version": "0.4.0",
  "description": "Local-first Qwen usage collector using OpenRouter.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.qwen.ai/*",
    "http://localhost:4000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "config-qwen.js",
        "content-qwen.js"
      ],
      "run_at": "document_idle"
    }
  ]
}