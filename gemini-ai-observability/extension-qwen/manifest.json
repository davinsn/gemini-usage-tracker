{
  "manifest_version": 3,
  "name": "Qwen AI Usage Collector",
  "version": "0.2.0",
  "description": "Local-first Qwen (Alibaba) usage metadata collector.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.qwen.ai/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "service-worker-qwen.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "config-qwen.js",
        "content-qwen.js"
      ],
      "run_at": "document_idle"
    }
  ]
}